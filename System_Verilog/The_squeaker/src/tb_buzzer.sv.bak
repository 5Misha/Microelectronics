module tb_buzzer;

    // Параметры тестового стенда
    parameter CLK_PERIOD = 20;  // 50 MHz
    parameter SIM_TIME = 1000000;
    
    // Сигналы
    logic clk;
    logic rst_n;
    logic btn_up;
    logic btn_down;
    logic pwm_out;
    
    // Переменные для проверки
    real measured_freq;
    int pulse_count;
    real last_edge_time;
    real current_time;
    
    // Экземпляр тестируемого модуля
    buzzer #(
        .CLK_FREQ(50_000_000)
    ) dut (
        .clk(clk),
        .rst_n(rst_n),
        .btn_up(btn_up),
        .btn_down(btn_down),
        .pwm_out(pwm_out)
    );
    
    // Генератор тактового сигнала
    initial begin
        clk = 0;
        forever #(CLK_PERIOD/2) clk = ~clk;
    end
    
    // Измерение частоты
    initial begin
        pulse_count = 0;
        last_edge_time = 0;
        forever begin
            @(posedge pwm_out);
            current_time = $time;
            if (last_edge_time > 0) begin
                measured_freq = 1_000_000_000 / (2 * (current_time - last_edge_time));
                $display("Время: %0t нс, Измеренная частота: %0.3f Гц", current_time, measured_freq);
            end
            last_edge_time = current_time;
            pulse_count++;
        end
    end
    
    // Основной процесс тестирования
    initial begin
        // Инициализация
        rst_n = 0;
        btn_up = 0;
        btn_down = 0;
        
        // Сброс
        #100;
        rst_n = 1;
        #1000;
        
        $display("=== Начало тестирования пищалки ===");
        $display("Проверка начальной частоты 1 кГц...");
        #10000; // Ждем несколько периодов
        
        // Тест увеличения частоты
        $display("=== Тест увеличения частоты ===");
        repeat(5) begin
            btn_up = 1;
            #100000; // Длительное нажатие
            btn_up = 0;
            #100000; // Пауза между нажатиями
        end
        
        // Тест уменьшения частоты
        $display("=== Тест уменьшения частоты ===");
        repeat(3) begin
            btn_down = 1;
            #100000;
            btn_down = 0;
            #100000;
        end
        
        // Тест граничных условий
        $display("=== Тест граничных условий ===");
        
        // Попытка уменьшить ниже минимальной
        repeat(10) begin
            btn_down = 1;
            #100000;
            btn_down = 0;
            #100000;
        end
        
        // Попытка увеличить выше максимальной
        repeat(25) begin
            btn_up = 1;
            #100000;
            btn_up = 0;
            #100000;
        end
        
        $display("=== Тестирование завершено ===");
        $display("Всего импульсов: %0d", pulse_count);
        #1000;
        $finish;
    end
    
    // Мониторинг изменений частоты
    always @(dut.target_freq) begin
        $display("Время: %0t нс, Установлена частота: %0d Гц", $time, dut.target_freq);
    end
    
    // Проверка скважности
    initial begin
        forever begin
            @(posedge pwm_out);
            #1; // Небольшая задержка для проверки
            if (pwm_out !== 1'b1) begin
                $error("Ошибка: Неправильный фронт ШИМ в время %0t", $time);
            end
        end
    end
    
    // Создание файла VCD для анализа
    initial begin
        $dumpfile("buzzer.vcd");
        $dumpvars(0, tb_buzzer);
    end

endmodule